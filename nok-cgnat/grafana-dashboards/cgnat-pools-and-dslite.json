{
  "id": null,
  "uid": "cgnat-pools-dslite",
  "title": "CG-NAT pools and DS-Lite",
  "tags": [
    "cgnat",
    "dslite"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 2,
