      "datasource": {
        "type": "prometheus",
        "uid": "DS_PROMETHEUS"
      },
      "targets": [
        {
          "expr": "state_router_nat_outside_pool_large_scale_group_member_block_usage",
          "legendFormat": "{{source}} {{name}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "DS_PROMETHEUS"
          }
        }
