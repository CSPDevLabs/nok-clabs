{
  "id": null,
  "uid": "cgnat-isa-icr",
  "title": "CG-NAT ISA and ICR",
  "tags": [
    "cgnat",
    "nat",
    "sros"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 2,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "annotations": {
    "list": [
      {
        "name": "NAT events (duplicate + log-only)",
        "datasource": {
          "type": "loki",
          "uid": "DS_LOKI"
        },
        "enable": true,
        "expr": "{job=\"syslog\", application=\"NAT\", event_id=~\"2003|2014|2015|2023|2024|2025|2040|2043\"}",
        "tagKeys": "event_id,source"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "A1 NAT group oper-state",
      "type": "stat",
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "DS_PROMETHEUS"
      },
      "targets": [
        {
          "expr": "state_isa_nat_group_oper_state",
          "legendFormat": "{{source}} ng={{id}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "DS_PROMETHEUS"
          }
        }
      ],
      "options": {},
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
