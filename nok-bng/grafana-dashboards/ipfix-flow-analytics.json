          "rawSql": "SELECT\n  COALESCE(raw_data->>'proto', 'Unknown') AS \"Protocol\",\n  COALESCE(raw_data->>'src_port', '0') AS \"Source port\",\n  COALESCE(raw_data->>'dst_port', '0') AS \"Destination port\",\n  COUNT(*) AS \"Flow records\",\n  SUM(COALESCE(NULLIF(raw_data->>'bytes', '')::numeric, 0)) AS \"Bytes\",\n  SUM(COALESCE(NULLIF(raw_data->>'packets', '')::numeric, 0)) AS \"Packets\"\nFROM public.ipfix_flows\nWHERE $__timeFilter(created_at)\n  AND ('${cluster_id:raw}' = '__all' OR cluster_id IN (${cluster_id:sqlstring}))\n  AND ('${source_topic:raw}' = '__all' OR source_topic IN (${source_topic:sqlstring}))\n  AND ('${device:raw}' = '__all' OR device IN (${device:sqlstring}))\n  AND UPPER(COALESCE(raw_data->>'proto', '')) IN ('TCP', 'UDP', 'SCTP')\nGROUP BY 1, 2, 3\nORDER BY \"Bytes\" DESC\nLIMIT 25;",
