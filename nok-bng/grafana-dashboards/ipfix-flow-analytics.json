    {
      "id": 3,
      "title": "Ingress / egress interface traffic",
      "type": "table",
      "datasource": {
        "type": "postgres",
        "uid": "DS_IPFIX_POSTGRES"
      },
      "gridPos": {
        "x": 16,
        "y": 13,
        "w": 8,
        "h": 8
