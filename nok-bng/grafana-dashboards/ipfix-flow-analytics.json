      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "DS_IPFIX_POSTGRES"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  direction AS \"Direction\",\n  interface AS \"Interface index\",\n  SUM(bytes) AS \"Bytes\",\n  SUM(packets) AS \"Packets\",\n  COUNT(*) AS \"Flow records\"\nFROM (\n  SELECT\n    'Ingress' AS direction,\n    COALESCE(raw_data->>'in_if', 'Unknown') AS interface,\n    COALESCE(NULLIF(raw_data->>'bytes', '')::numeric, 0) AS bytes,\n    COALESCE(NULLIF(raw_data->>'packets', '')::numeric, 0) AS packets\n  FROM public.ipfix_flows\n  WHERE $__timeFilter(created_at)\n    AND ('${cluster_id:raw}' = '__all' OR cluster_id IN (${cluster_id:sqlstring}))\n    AND ('${source_topic:raw}' = '__all' OR source_topic IN (${source_topic:sqlstring}))\n    AND ('${device:raw}' = '__all' OR device IN (${device:sqlstring}))\n  UNION ALL\n  SELECT\n    'Egress' AS direction,\n    COALESCE(raw_data->>'out_if', 'Unknown') AS interface,\n    COALESCE(NULLIF(raw_data->>'bytes', '')::numeric, 0) AS bytes,\n    COALESCE(NULLIF(raw_data->>'packets', '')::numeric, 0) AS packets\n  FROM public.ipfix_flows\n  WHERE $__timeFilter(created_at)\n    AND ('${cluster_id:raw}' = '__all' OR cluster_id IN (${cluster_id:sqlstring}))\n    AND ('${source_topic:raw}' = '__all' OR source_topic IN (${source_topic:sqlstring}))\n    AND ('${device:raw}' = '__all' OR device IN (${device:sqlstring}))\n) interface_traffic\nGROUP BY direction, interface\nORDER BY \"Bytes\" DESC\nLIMIT 50;",
          "refId": "A"
        }
